{
  "dataset": "factory",
  "name": "Review verdicts",
  "description": "The reviewer's verdicts per day (approve, request_changes, ...). Reads run.finished with agent_d = reviewer.",
  "query": {
    "calculations": [
      {
        "op": "COUNT"
      }
    ],
    "filters": [
      {
        "column": "name",
        "op": "=",
        "value": "run.finished"
      },
      {
        "column": "agent_d",
        "op": "=",
        "value": "reviewer"
      }
    ],
    "filter_combination": "AND",
    "breakdowns": [
      "verdict"
    ],
    "time_range": 604800,
    "granularity": 86400
  },
  "query_style": "graph",
  "visualization_settings": {
    "utc_xaxis": true,
    "charts": [
      {
        "chart_index": 0,
        "chart_type": "stacked"
      }
    ]
  },
  "position": {
    "x_coordinate": 0,
    "y_coordinate": 46,
    "width": 12,
    "height": 4
  }
}
