{
  "dataset": "factory",
  "name": "PR acceptance",
  "description": "Of the factory PRs closed in the last 30 days, the share merged (AVG pr_merged) and the share merged without a revise round (AVG pr_first_pass), per agent. Reads pr.closed.",
  "query": {
    "calculations": [
      {
        "op": "AVG",
        "column": "pr_merged"
      },
      {
        "op": "AVG",
        "column": "pr_first_pass"
      },
      {
        "op": "COUNT"
      }
    ],
    "filters": [
      {
        "column": "name",
        "op": "=",
        "value": "pr.closed"
      }
    ],
    "filter_combination": "AND",
    "breakdowns": [
      "agent"
    ],
    "time_range": 2592000
  },
  "query_style": "table",
  "position": {
    "x_coordinate": 0,
    "y_coordinate": 42,
    "width": 6,
    "height": 4
  }
}
