{
  "dataset": "factory",
  "name": "PRs opened per day",
  "description": "Factory PRs opened per day by agent (builder, bug-fixer). Reads pr.opened.",
  "query": {
    "calculations": [
      {
        "op": "COUNT"
      }
    ],
    "filters": [
      {
        "column": "name",
        "op": "=",
        "value": "pr.opened"
      }
    ],
    "filter_combination": "AND",
    "breakdowns": [
      "agent"
    ],
    "time_range": 2592000,
    "granularity": 86400
  },
  "query_style": "graph",
  "visualization_settings": {
    "utc_xaxis": true,
    "charts": [
      {
        "chart_index": 0,
        "chart_type": "stacked"
      }
    ]
  },
  "position": {
    "x_coordinate": 0,
    "y_coordinate": 54,
    "width": 6,
    "height": 4
  }
}
