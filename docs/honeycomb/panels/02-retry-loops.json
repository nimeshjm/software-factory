{
  "dataset": "factory",
  "name": "Retry loops",
  "description": "Shows: Subjects (issues) with more than one failed, timeout or lost run in the last 24 hours, per agent. Reads run.finished.\nWhy it matters: An issue that fails over and over keeps burning quota on the same dead end and blocks the backlog behind it. Each row is a candidate to park and fix by hand.",
  "query": {
    "calculations": [
      {
        "op": "COUNT"
      }
    ],
    "filters": [
      {
        "column": "name",
        "op": "=",
        "value": "run.finished"
      },
      {
        "column": "status",
        "op": "in",
        "value": [
          "failed",
          "timeout",
          "lost"
        ]
      }
    ],
    "filter_combination": "AND",
    "breakdowns": [
      "subject",
      "agent_d"
    ],
    "havings": [
      {
        "calculate_op": "COUNT",
        "op": ">",
        "value": 1
      }
    ],
    "orders": [
      {
        "op": "COUNT",
        "order": "descending"
      }
    ],
    "time_range": 86400
  },
  "query_style": "table",
  "position": {
    "x_coordinate": 4,
    "y_coordinate": 5,
    "width": 8,
    "height": 4
  }
}
