{
  "dataset": "software-factory",
  "name": "Tool guard denials",
  "description": "Tool calls the guard blocked, by agent and rule. Reads the tool_guard.blocked span event.",
  "query": {
    "calculations": [
      {
        "op": "COUNT"
      }
    ],
    "filters": [
      {
        "column": "name",
        "op": "=",
        "value": "tool_guard.blocked"
      }
    ],
    "filter_combination": "AND",
    "breakdowns": [
      "factory.agent",
      "rule"
    ],
    "time_range": 604800,
    "orders": [
      {
        "op": "COUNT",
        "order": "descending"
      }
    ]
  },
  "query_style": "table",
  "position": {
    "x_coordinate": 0,
    "y_coordinate": 38,
    "width": 6,
    "height": 4
  }
}
