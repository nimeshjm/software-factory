{
  "dataset": "software-factory",
  "name": "Input tokens by request number",
  "description": "Average estimated prompt size (factory.prompt.total_tokens) and its history part by request number within a phase, over 7 days. A flat line means the fixed prompt dominates (cut the task message or system prompt); a steep one means the history does (trimming, batching, fewer reads).",
  "query": {
    "calculations": [
      {
        "op": "AVG",
        "column": "factory.prompt.total_tokens"
      },
      {
        "op": "AVG",
        "column": "factory.prompt.history_tokens"
      },
      {
        "op": "COUNT"
      }
    ],
    "filters": [
      {
        "column": "name",
        "op": "=",
        "value": "factory.prompt"
      }
    ],
    "filter_combination": "AND",
    "breakdowns": [
      "factory.agent",
      "factory.prompt.request"
    ],
    "orders": [
      {
        "column": "factory.agent",
        "order": "ascending"
      },
      {
        "column": "factory.prompt.request",
        "order": "ascending"
      }
    ],
    "limit": 200,
    "time_range": 604800
  },
  "query_style": "table",
  "position": {
    "x_coordinate": 0,
    "y_coordinate": 78,
    "width": 6,
    "height": 4
  }
}
